{
  "name": "task-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "A simple React and Electron task tracker.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "check:project-folder-safety": "node scripts/check-project-folder-safety.cjs",
    "build": "npm run check:project-folder-safety && vite build",
    "dist:win": "node scripts/dist-win.cjs",
    "start": "electron ."
  },
  "build": {
    "appId": "com.tasktracker.app",
    "productName": "Task Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "guid": "4d887ba5-f89a-5609-95eb-1d872e27e174",
      "artifactName": "TaskTracker-v${env.RELEASE_NUMBER}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "vite": "latest",
    "wait-on": "latest"
  }
}
