{
  "name": "taks-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "A simple React and Electron task tracker.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win --x64",
    "start": "electron ."
  },
  "build": {
    "appId": "com.takstracker.app",
    "productName": "Taks Tracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "vite": "latest",
    "wait-on": "latest"
  }
}
